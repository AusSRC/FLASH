# Note DO NOT EDIT THIS FILE! Make a copy to secrets.env in the same location
# fill it in and make sure its not committed (it IS in gitignore &
# dockerignores already)

# Shared Secrets
# ---------------------------------------
DB_HOST=your-dev-db-host
DB_USER=your-dev-db-user
DB_PASSWORD=your-dev-db-password
DB_NAME=your-dev-db-name
DB_PORT=5432

# Service Secrets
# ---------------------------------------
DJANGO_SECRET_KEY=your_large_secret_cryptographic_key_for_dev_deploy_of_django
DJANGO_ALLOWED_HOST=the_dev_domain_you_will_deploy_at

# Job Secrets
# ---------------------------------------
# Set who to connect to CASDA as
CASDA_EMAIL=your-casda-email
CASDA_PWD=your-casda-pasword

# Set path to cron scripts in the job docker
CRONDIR=path-to-cronjobs-code-in-docker
FLASHDB=path-to-database-code-in-docker

# Set which HPC platform we will connect to
HPC_PLATFORM=your-hpc-platform
HPC_USER=your-hpc-user

# Set where to look on HPC platform for the data
HPC_SCRATCH=your-hpc-scratch-path

# Set a DATA & TMP dir the copy job will copy HPC data products to on VM before
# upload (some of it goes to tmp, some to data):
DATA=path-to-copy-data-to-on-vm
TMPDIR=path-to-copy-data-to-on-vm-tmp

# Set where on the VM to copy blacklists to
BLACKLIST_DIRS=path-to-copy-blacklist-to-on-vm


